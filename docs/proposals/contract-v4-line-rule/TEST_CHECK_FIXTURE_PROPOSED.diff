+# A résumé unit gives one status to every skill on it (contract v4), so the two-status line is labelled in the posting.
+POST_NOTES = POST + "\nNotes:\nNo CFD experience; currently studying CFD\n"  # engine: 1st negated, 2nd hypothetical
+
+
+def pcheck(**kw):
+    return check(**{"posting_text": POST_NOTES, **kw})
+
+
+def plab(status, **kw):
+    return {**lab(status, **kw), "doc": "posting"}
+
+
