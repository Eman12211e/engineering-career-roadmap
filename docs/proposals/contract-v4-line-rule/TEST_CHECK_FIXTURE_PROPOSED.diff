+def test_resume_labels_one_state_per_unit():
+    resume = "Experience\n- Ran CFD on the intake manifold\n- Ran CFD and repeated CFD without a mesh study\n"
+
+    def rlab(needle, status, **kw):
+        return {"doc": "resume", "line_contains": needle, "canonical": "CFD", "status": status, **kw}
+
+    ok = check(resume_text=resume, mention_labels=[rlab("intake", "affirmed"), rlab("mesh study", "unresolved")])
+    assert ok["status"] == [True, True]
+    per = check(resume_text=resume, mention_labels=[rlab("mesh study", "unresolved", occurrence=1),
+                                                    rlab("mesh study", "unresolved", occurrence=2)])
+    assert per["status"] == [True, True]
+    bad = check(resume_text=resume, mention_labels=[rlab("mesh study", "affirmed")])
+    assert bad["status"] == [False] and any("got unresolved" in f for f in bad["fails"])
